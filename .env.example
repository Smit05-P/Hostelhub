# ========================================================
# HostelHub - Environment Configuration Template
# Copy this file to .env.local and fill in the values below.
# ========================================================

# Base URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# MongoDB Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/hostelhub
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hostelhub

# Authentication Security
# Generate a cryptographically secure random 256-bit string (e.g. `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# Google OAuth 2.0 Configuration
# Obtain credentials from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID for "Web application"
# 3. Add Authorized JavaScript origins:
#    - http://localhost:3000
#    - http://127.0.0.1:3000
# 4. Add Authorized redirect URIs (if using redirect-based OAuth):
#    - http://localhost:3000/api/auth/google/callback
#    - http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Intel Features (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key
